# ==============================================================================
# QueueSense — Environment Variables Template
# Copy this file to .env for local deployment.
# DO NOT COMMIT .env TO VERSION CONTROL.
# ==============================================================================

# Server Configuration
PORT=8080

# Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/queuesense
DB_USERNAME=postgres
DB_PASSWORD=your_secure_db_password_here

# Security / JWT Configuration (Must be >= 256 bits / 32 characters)
JWT_SECRET=your_secure_random_jwt_secret_key_at_least_32_characters_long
JWT_EXPIRATION_MS=86400000

# Booking Engine Rules
BOOKING_GRACE_PERIOD_MINS=10
